<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.library.mapper.BasicDataMapper">

    <select id="selectAuthors" resultType="com.example.library.vo.AuthorVO">
        SELECT
            author_id,
            author_name,
            nationality,
            author_intro
        FROM author
        ORDER BY author_id
    </select>

    <select id="selectBookTypes" resultType="com.example.library.vo.BookTypeVO">
        SELECT
            type_id,
            type_name,
            type_desc
        FROM book_type
        ORDER BY type_id
    </select>

    <select id="selectRoles" resultType="com.example.library.vo.RoleVO">
        SELECT
            role_id,
            role_name,
            role_desc,
            create_time
        FROM sys_role
        ORDER BY role_id
    </select>
</mapper>
